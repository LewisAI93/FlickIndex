/* =========================================
   COLOUR THEMES
   ========================================= */

# /* --- AMBER PHOSPHOR PALETTE --- */
# $primary: #FFB300;
# $accent: #221A0C;
# $surface: #121212;
# $secondary: #855E00;
# $text: #FFD580;
# $muted_grey: #333333;

# /* Deep orange */ 
$primary: #FF8F00;
$secondary: #E65100;
$accent: #221A0C;
$surface: #121212;
$text: #FFF3E0;
$muted_grey: #333333;


/* =========================================
   GLOBAL STYLES
   ========================================= */
Screen {
    background: $surface;
    color: $text;
}

* {
    scrollbar-color: $secondary;
    scrollbar-color-hover: $primary;
    scrollbar-size: 1 1;
}

#screen_frame {
    border: round $secondary;
    padding: 0 2; 
    margin: 1 4; 
    background: $surface;
    height: 1fr;
}

#screen_frame > Horizontal {
    align: center middle;
    height: 1fr;
}

#system_status {
    width: 100%;
    text-align: right;
    color: $secondary; 
    text-style: italic;
    margin-bottom: 1; 
    margin-top: 1;
}

/* =========================================
   LAYOUT PANES
   ========================================= */
#left_pane, #center_pane, #right_pane {
    padding: 0 2;
    height: 100%; 
    border: none;
}

#left_pane { width: 30%; }
#center_pane { width: 40%; }
#right_pane { width: 30%; }

/* =========================================
   HEADERS
   ========================================= */
#main_title {
    color: $primary;
    text-align: center;
    text-style: bold;
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

#ascii_header {
    width: 100%;
    content-align: center middle;
    color: $primary;
    background: transparent;
    height: auto;
    margin: 1 0;
}

/* Base style for side panels (Favourites, Watchlist, etc.) */
.side_heading {
    background: transparent;
    color: $primary;
    text-style: bold;
    width: 100%;
    padding: 0 1;
    margin-bottom: 0;
    border-bottom: solid $muted_grey; 
}

/* High-Contrast Solid Bars (Home, Genres, Movie Title) */
#search_header, 
#trending_header, 
#genres_header, 
#genre_results_header,
#movie_title_header {
    background: $primary;
    color: #5C2300;
    text-style: bold;
    width: 100%;
    content-align: center middle;
}

/* Specific override for Movie Title height/padding */
#movie_title_header {
    padding: 1 2;
    margin-bottom: 1;
}

.section_heading, #collection_header {
    background: $secondary; 
    color: $primary;      
    text-style: bold;
    width: 100%;
    padding: 0 1;
    margin-bottom: 0;
    border: none;
}

/* =========================================
   INPUTS
   ========================================= */
Input {
    border: round $secondary;
    background: $surface;
    color: $primary;
    margin-bottom: 0; 
    padding: 0 1; 
    width: 100%;
}

Input:focus {
    border: round $primary;
}

/* =========================================
   BUTTONS
   ========================================= */
Button {
    background: $surface;
    color: $secondary;
    border: round $secondary;
    height: 3;
    content-align: center middle;
    margin: 0;
}

Button:hover, Button:focus {
    background: $surface;
    color: $primary;      
    border: round $primary; 
    text-style: bold;
}

#search_button_row {
    height: auto; 
    width: 100%;
    margin: 0; 
}

#search_button_row Button {
    width: 50%;
}

#right_pane Button {
    margin-top: 0;    
    margin-bottom: 2; 
    width: 100%; 
}

#quit_button {
    border: round #662222; 
    color: #883333;
    width: 100%;
    dock: bottom; 
    margin-bottom: 1;
}

#quit_button:hover, #quit_button:focus {
    border: round #FF4400; 
    color: #FF4400;
}

/* =========================================
   LISTS
   ========================================= */
ListView, Vertical#trending_container {
    border: round $secondary;
    margin-top: 0; 
    margin-bottom: 1;
    padding: 0 1; 
    width: 100%;
    height: auto;
    max-height: 18;
    min-height: 4; 
    background: $surface;
}

#right_pane ListView {
    margin-bottom: 0; 
}

ListView > ListItem.--highlight,
ListView:focus > ListItem.--highlight,
ListItem:focus {
    background: $secondary; 
    color: $primary;
    text-style: bold;
    margin: 0; 
}

/* Fix unreadable titles in lists */
ListItem > Label {
    color: #FFECB3;  
}

ListItem.-highlighted > Label {
    text-style: bold;
    color: $surface; 
}

/* =========================================
   SPECIFIC SCREENS (MOVIE / GENRE)
   ========================================= */
#movie_details { width: 1fr; padding: 1 2; }
#similar_pane { width: 1fr; padding: 1 2; border: none; }
#genre_sidebar { width: 30; height: 100%; border-right: solid $secondary; padding: 1; }
#genre_results_pane { width: 1fr; height: 100%; padding: 1; }

#movie_meta {
    color: $primary;
    margin-bottom: 2;
}

#movie_overview {
    width: 100%;
    height: auto; 
    color: $text;
    margin-top: 1; 
    margin-bottom: 3;
}

#movie_action_buttons {
    height: auto;
    width: 100%;
}

#movie_action_buttons Button {
    width: 1fr;
    margin: 0 1 0 0;
}

/* =========================================
   HEADER & FOOTER OVERRIDES
   ========================================= */
Header {
    background: $surface;
    color: $primary;
}

HeaderIcon {
    display: none; 
}

HeaderClock {
    color: $secondary;
}

Footer {
    background: $surface;
    color: $secondary;
}

Footer > .footer--highlight {
    background: $secondary;
    color: $surface;
}

Footer > .footer--highlight-key {
    background: $primary;
    color: $surface;
    text-style: bold;
}